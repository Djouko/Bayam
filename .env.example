# Variables de BAYAM en production (docker-compose.prod.yml). Easypanel recopie ce fichier dans son éditeur
# d'environnement : remplacer chaque valeur. Ne jamais mettre de vraie valeur dans ce fichier (il est dans git).
# Fichier prêt à coller, généré depuis le poste : python scripts/env_production.py (voir DEPLOIEMENT.md).

# Adresse publique du site, sans barre finale (domaine Easypanel en attendant le domaine de BAYAM).
BAYAM_URL_PUBLIQUE=https://bayam.exemple.easypanel.host

# Restauration au premier déploiement (nom de la sauvegarde envoyée depuis le poste), puis plus rien.
BAYAM_RESTAURER=
# « oui » seulement si les sessions WhatsApp du poste sont arrêtées (sinon WhatsApp déconnecte les deux).
RESTAURER_WHATSAPP=non

# Bases et bus (une valeur longue et aléatoire chacune : openssl rand -hex 32).
DB_PASSWORD=
DB_ROOT_PASSWORD=
POSTGRES_PASSWORD=
CANAL_WHATSAPP_DB_PASSWORD=
CANAL_FACEBOOK_DB_PASSWORD=
RETOURS_DB_PASSWORD=
REDIS_MOT_DE_PASSE=
NATS_MDP_PASSERELLE=
NATS_MDP_CANAL_WHATSAPP=
NATS_MDP_CANAL_FACEBOOK=

# Jeton de l'API interne et clé des liens signés (distincts).
BAYAM_SERVICE_JETON=
BAYAM_CLE_LIENS=

# Clés de sécurité de WordPress (https://api.wordpress.org/secret-key/1.1/salt/ ou openssl rand -hex 32).
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# Comptes créés par une installation neuve (sans restauration).
WP_ADMIN=direction
WP_ADMIN_PASSWORD=
WP_VENDOR_PASSWORD=

# WhatsApp (WAHA). Garder les valeurs du poste en cas de restauration des sessions.
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_DASHBOARD_PASSWORD=
# Alertes de l'équipe : session:chat (« Message à moi-même » d'un numéro relié).
RETOURS_ALERTE_WHATSAPP=

# Facebook (application Meta). FACEBOOK_CLE déchiffre les jetons de Page : garder celle du poste en cas de restauration.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=
FACEBOOK_JETON_VERIFICATION=
FACEBOOK_CLE=

# Paiements et assistant.
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_ENV=sandbox
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Cloudflare R2 (sauvegardes, médias ; offre gratuite).
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
