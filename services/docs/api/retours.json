{
  "openapi": "3.0.3",
  "info": {
    "title": "BAYAM, service des retours",
    "version": "1.0.0",
    "description": "Signalements, idées et pannes détectées : regroupement des doublons en sujets, urgence, suivi jusqu'à la résolution, réponse aux signaleurs."
  },
  "components": {
    "securitySchemes": {
      "service": {
        "type": "apiKey",
        "in": "header",
        "name": "x-bayam-service",
        "description": "jeton de service partagé (réseau interne)"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/retours": {
      "post": {
        "summary": "Signaler un souci ou proposer une idée depuis l'application ou le site",
        "tags": [
          "public"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "texte"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "souci",
                      "idee",
                      "question"
                    ]
                  },
                  "texte": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 2000
                  },
                  "canal": {
                    "type": "string",
                    "enum": [
                      "app",
                      "web"
                    ],
                    "default": "app"
                  },
                  "contexte": {
                    "type": "object",
                    "maxProperties": 12,
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "description": "version, plateforme, écran, appareil"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "numero": {
                      "type": "string",
                      "description": "numéro à donner à la personne (R-123)"
                    },
                    "sujet": {
                      "type": "integer"
                    },
                    "signaleurs": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string",
                      "description": "réponse prête à envoyer à la personne"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "erreur": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/interne/signalements": {
      "post": {
        "summary": "Enregistrer un retour reçu sur un canal (WhatsApp, Messenger, copilote, administration)",
        "tags": [
          "interne"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "texte",
                  "canal"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "souci",
                      "idee",
                      "question"
                    ]
                  },
                  "texte": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 2000
                  },
                  "canal": {
                    "type": "string",
                    "enum": [
                      "whatsapp",
                      "messenger",
                      "copilote",
                      "app",
                      "web",
                      "admin"
                    ]
                  },
                  "auteur": {
                    "type": "string",
                    "maxLength": 120,
                    "description": "nom lisible par l'équipe (boutique, prénom)"
                  },
                  "vendeur": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fonction": {
                    "type": "string",
                    "pattern": "^[a-z][a-z.]{1,59}$",
                    "description": "fonction touchée (whatsapp.menu, paiement…)"
                  },
                  "contact": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "canal",
                          "session",
                          "chat"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "canal": {
                            "enum": [
                              "whatsapp"
                            ]
                          },
                          "session": {
                            "type": "string",
                            "pattern": "^[\\w-]{1,64}$"
                          },
                          "chat": {
                            "type": "string",
                            "pattern": "^[\\w.-]{3,64}@(c\\.us|lid|s\\.whatsapp\\.net)$"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "canal",
                          "page",
                          "client"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "canal": {
                            "enum": [
                              "messenger"
                            ]
                          },
                          "page": {
                            "type": "string",
                            "pattern": "^\\d{1,20}$"
                          },
                          "client": {
                            "type": "string",
                            "pattern": "^\\d{1,30}$"
                          }
                        }
                      }
                    ],
                    "description": "où prévenir la personne quand ce sera réglé"
                  },
                  "contexte": {
                    "type": "object",
                    "maxProperties": 12,
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "identifiant": {
                    "type": "string",
                    "maxLength": 120,
                    "description": "identifiant stable de la personne, jamais stocké en clair"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "service": []
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "numero": {
                      "type": "string",
                      "description": "numéro à donner à la personne (R-123)"
                    },
                    "sujet": {
                      "type": "integer"
                    },
                    "signaleurs": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string",
                      "description": "réponse prête à envoyer à la personne"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "erreur": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "erreur": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
