      "patch": {
        "summary": "Décision sur un sujet (statut, responsable, gravité, résolution) et réponse aux signaleurs",
        "tags": [
          "interne"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "auteur"
                ],
                "additionalProperties": false,
                "properties": {
                  "auteur": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "statut": {
                    "type": "string",
                    "enum": [
                      "nouveau",
                      "confirme",
                      "en_cours",
                      "corrige",
                      "ferme",
                      "rejete"
                    ]
                  },
                  "assigne": {
                    "type": "string",
                    "maxLength": 80,
                    "nullable": true
                  },
                  "gravite": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "categorie": {
                    "type": "string",
                    "enum": [
                      "securite",
                      "paiement",
                      "livraison",
                      "commande",
                      "connexion",
                      "whatsapp",
                      "facebook",
                      "application",
                      "photos",
                      "disponibilite",
                      "autre"
                    ]
                  },
                  "resolution": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "prevenir": {
                    "type": "boolean",
                    "description": "prévenir les signaleurs joignables (avec un statut corrigé)"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 1000,
                    "description": "message aux signaleurs, sinon le message standard"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "in": "path",
